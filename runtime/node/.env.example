# === Cosmo runtime configuration ===
# Copy this file to .env and fill in your values. Never commit the .env file.

# --- Anthropic (required) -----------------------------------------------------
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Suggested: claude-sonnet-4-5-20250929 (fast+strong) or
# claude-opus-4-5-20250514 (highest quality). Whatever your account has access to.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Max output tokens per response (Anthropic default 4096; raise for long Phase 4 code emits).
ANTHROPIC_MAX_TOKENS=8192

# --- Cosmo (optional) ---------------------------------------------------------
# Absolute path to cosmo.system-prompt.md. Defaults to ../../cosmo.system-prompt.md relative to this runtime.
COSMO_SYSTEM_PROMPT_PATH=

# --- Figma MCP (optional but recommended) ------------------------------------
# Enable the Figma MCP client. Set to "false" to run in describe-only / no-library mode.
FIGMA_MCP_ENABLED=true

# The command Cosmo should exec to start your Figma MCP server (stdio transport).
# Examples:
#   FIGMA_MCP_COMMAND=npx
#   FIGMA_MCP_ARGS=-y,figma-developer-mcp
# or
#   FIGMA_MCP_COMMAND=/usr/local/bin/figma-mcp
#   FIGMA_MCP_ARGS=
FIGMA_MCP_COMMAND=npx
FIGMA_MCP_ARGS=-y,figma-developer-mcp

# Figma personal access token (used by the Figma MCP process, not by Cosmo directly).
# Generate at https://www.figma.com/settings — Personal access tokens.
FIGMA_ACCESS_TOKEN=figd_...

# --- Runtime behavior (optional) ---------------------------------------------
# Show a preamble line telling the user how to exit. Default: true.
COSMO_SHOW_PREAMBLE=true

# Print each turn's token counts. Default: false.
COSMO_LOG_TOKENS=false
